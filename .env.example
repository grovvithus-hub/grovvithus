# Local: SQLite. Render: the Internal Database URL of a Render Postgres. Hostinger: mysql://USER:PASSWORD@127.0.0.1:3306/DBNAME
DATABASE_URL="file:./dev.db"
# 48+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
APP_URL="http://localhost:3000"
# First Super Admin, created by 
pm run seed
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
DISABLE_EMAILS="true"
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
ADMIN_NOTIFY_EMAIL=""
# Secret for POST /api/cron/refresh-statuses
CRON_SECRET=""

# Public website (optional)
# Digits with country code, e.g. 919876543210. Shows the WhatsApp button and links.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_EMAIL=""

# Built-in scheduler (production). Keep-awake pings APP_URL every 10 minutes so a free Render service does not sleep.
# Set KEEP_AWAKE=false on a paid always-on instance. Optional: KEEP_AWAKE_INTERVAL_SECONDS (5-840).
KEEP_AWAKE=""
